{
  "name": "@wedding-planner/app",
  "version": "0.0.1",
  "productName": "Open Wedding Planner",
  "description": "AI-powered wedding planning assistant",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "electron-vite build && vite build --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "prepare-browsers": "node scripts/prepare-browsers.mjs",
    "prepare-cloudflared": "node scripts/prepare-cloudflared.mjs",
    "postinstall": "node scripts/prepare-cloudflared.mjs",
    "package": "npm run prepare-browsers && npm run prepare-cloudflared && electron-vite build && npm run build:web && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@wedding-planner/shared": "*",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
